{
	"extends": "@vue/tsconfig/tsconfig.json",
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"sourceMap": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"lib": ["esnext", "dom"],
		"types": [
			"@dcloudio/types",
			"@ttou/uview-typings/v3",
			"@ttou/uview-typings/refs"
		]
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue", "src/main.uts"],

	"moduleResolution": "node",
	"ignoreDeprecations": "5.0",
}